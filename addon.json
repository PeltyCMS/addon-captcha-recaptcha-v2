{
  "id": "captcha-recaptcha-v2",
  "name": "Google reCAPTCHA v2",
  "version": "0.1.0",
  "kind": "captcha",
  "engine": "wasm",
  "provides": "recaptcha_v2",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.captcha.recaptcha_v2",
  "author": "MythicalSystems",
  "permissions": [
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "www.google.com",
      "www.recaptcha.net",
      "$setting:verify_url"
    ],
    "secrets": []
  },
  "settings": [
    {
      "key": "site_key",
      "label": "addons.captcha.setting.site_key",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "secret_key",
      "label": "addons.captcha.setting.secret_key",
      "kind": "secret",
      "required": false,
      "default": ""
    },
    {
      "key": "verify_url",
      "label": "addons.captcha.setting.verify_url",
      "kind": "text",
      "required": false,
      "default": ""
    }
  ]
}
